#!/usr/bin/env bash
# Inicia TF2 e mantém ativa a cópia local de demos concluídas.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

usage() {
  cat <<'HELP'
Uso: ./scripts/tf2coach [--dry-run | --help]
  --dry-run  Exibe o comando sem iniciar Steam/TF2 ou sincronizador.
  --help     Mostra esta ajuda.

O launcher mantém o sincronizador ativo no terminal. Ctrl+C encerra apenas o
sincronizador; demos originais não são alteradas nem removidas.
HELP
}

if [[ $# -gt 1 ]]; then usage >&2; exit 2; fi
case "${1:-}" in
  --help|-h) usage; exit 0 ;;
  ''|--dry-run) ;;
  *) usage >&2; exit 2 ;;
esac

command=(
  steam -applaunch 440
  -novid -console
  +ds_dir tf2coach
  +ds_log 1
  +ds_screens 0
  +ds_autodelete 0
  +ds_enable 2
)

if [[ "${1:-}" == "--dry-run" ]]; then
  printf 'Comando do jogo: setsid '
  printf '%q ' "${command[@]}"
  printf '\nSincronizador: python3 %q --repo-root %q\n' "$SCRIPT_DIR/demo_sync.py" "$REPO_ROOT"
  printf 'Destino local: %s/data/demos (limite: 2 GiB)\n' "$REPO_ROOT"
  exit 0
fi

for tool in steam python3 setsid; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    printf 'ERRO: executável %s não encontrado no PATH.\n' "$tool" >&2
    exit 127
  fi
done

python3 "$SCRIPT_DIR/demo_sync.py" --repo-root "$REPO_ROOT" &
sync_pid=$!
cleanup() {
  trap - INT TERM EXIT
  kill -INT "$sync_pid" 2>/dev/null || true
  wait "$sync_pid" 2>/dev/null || true
}
trap cleanup INT TERM EXIT

setsid "${command[@]}"
printf 'TF2 solicitado à Steam; sincronizador ativo. Ctrl+C encerra a cópia local.\n'
wait "$sync_pid"
